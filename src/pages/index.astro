---
import BaseLayout from '../layouts/BaseLayout.astro';
import VectorProps from '../components/VectorProps.astro';
import '../styles/global.css';

import scene01Svg from '../assets/svg/scene-01-intro.svg?raw';
import scene02Svg from '../assets/svg/scene-02-acto1.svg?raw';
import scene03Svg from '../assets/svg/scene-03-acto2.svg?raw';
import scene04Svg from '../assets/svg/scene-04-acto3.svg?raw';
import scene05Svg from '../assets/svg/scene-05-acto4.svg?raw';
import scene06Svg from '../assets/svg/scene-06-outro.svg?raw';

const stats = [
  { label: 'LEALTAD INQUEBRANTABLE', value: '100%' },
  { label: 'CORAJE SIN FRONTERAS', value: '100%' },
  { label: 'RESILIENCIA DE ACERO', value: '100%' },
  { label: 'AMOR DE MADRE', value: '∞%' },
];
---

<BaseLayout title="GTA: MAMÁ — Corina (Edición Leyenda)">
  <div class="gta-atmosphere-overlay" aria-hidden="true"></div>

  <!-- Rockstar-Style Fixed HUD -->
  <header class="gta-hud">
    <div class="hud-badge">
      <span class="hud-badge-dot"></span>
      <span class="hud-title">CORINA • NIVEL 58 • EDICIÓN LEYENDA</span>
    </div>
    <div class="hud-stars-wrap">
      <VectorProps type="gta-star-rating" />
    </div>
  </header>

  <!-- Quick Chapter Navigation (Ideal for TV / Laptop / Touch) -->
  <nav class="chapter-nav" aria-label="Capítulos de la historia">
    <button class="chapter-dot is-active" data-target="#intro" title="Intro: GTA Mamá" aria-label="Ir a Intro"></button>
    <button class="chapter-dot" data-target="#acto-1" title="Acto I: Nadie se queda atrás" aria-label="Ir a Acto I"></button>
    <button class="chapter-dot" data-target="#acto-2" title="Acto II: Salto sin red" aria-label="Ir a Acto II"></button>
    <button class="chapter-dot" data-target="#acto-3" title="Acto III: Inquebrantable" aria-label="Ir a Acto III"></button>
    <button class="chapter-dot" data-target="#acto-4" title="Acto IV: Creando Vida con Hilos" aria-label="Ir a Acto IV"></button>
    <button class="chapter-dot" data-target="#outro" title="Misión de Mañana: Celebrar" aria-label="Ir a Carta Final"></button>
  </nav>

  <main>
    <!-- ==========================================
         CAPÍTULO 00 — INTRO: GTA MAMÁ (EDICIÓN LEYENDA)
         ========================================== -->
    <section id="intro" class="hero-section" data-chapter="intro">
      <div class="hero-bg-aura" aria-hidden="true"></div>

      <div class="hero-grid">
        <div class="hero-copy">
          <span class="gta-kicker">ROCKSTAR MOM PRESENTS • DÍA DE LA MADRE</span>
          <h1 class="gta-main-title">
            GTA: <span>CORINA</span>
          </h1>
          <p class="gta-subtitle">
            Hay personas que juegan la vida en modo fácil, y hay madres como vos que entran directo en <strong>Modo Leyenda</strong>: sin abandonar jamás a los suyos, cruzando fronteras y convirtiendo cada prueba imposible en una victoria.
          </p>

          <div class="gta-stats-grid" role="list" aria-label="Estadísticas de Corina">
            {stats.map((stat) => (
              <div class="stat-card" role="listitem">
                <div class="stat-header">
                  <span>{stat.label}</span>
                  <span>{stat.value}</span>
                </div>
                <div class="stat-bar-track">
                  <div class="stat-bar-fill"></div>
                </div>
              </div>
            ))}
          </div>

          <a href="#acto-1" class="gta-cta-btn">
            <span>INICIAR MISIONES DE VIDA</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="hero-visual">
          <div class="gta-poster-frame" data-poster>
            <div class="svg-stage" set:html={scene01Svg} />
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         ACTO I — NADIE SE QUEDA ATRÁS (PERÚ / FIBIO)
         ========================================== -->
    <section id="acto-1" class="story-act" data-chapter="acto-1">
      <div class="act-container">
        <div class="act-visual">
          <div class="gta-poster-frame" data-poster>
            <div class="svg-stage" set:html={scene02Svg} />
            <div class="poster-prop-floating prop-bottom-left">
              <VectorProps type="ecg-monitor" />
            </div>
          </div>
        </div>

        <article class="act-card">
          <div class="act-mission-tag">MISIÓN 01 • LEALTAD ABSOLUTA</div>
          <p class="act-location">📍 PERÚ • EL MILAGRO DE NO SOLTAR LA MANO</p>
          <h2 class="act-heading">NADIE SE QUEDA ATRÁS</h2>
          <p class="act-narrative">
            Cuando mi papá sufrió aquel ACV que le paralizó la mitad del cuerpo, el diagnóstico médico decía que nunca más iba a volver a caminar. Incluso hubo quienes te decían que lo dejes, que era una carga demasiado pesada.
          </p>
          <p class="act-narrative">
            Pero ellos <strong>no te conocían</strong>. Te quedaste firme a su lado, moviste cielo y tierra, y a pura paciencia y perseverancia lograste lo que parecía imposible: hoy las secuelas son mínimas y él camina a la par tuya porque vos jamás le soltaste la mano.
          </p>
          <div class="mission-reward-box">
            <span class="reward-label">LOGRO DESBLOQUEADO</span>
            <span class="reward-value">+1000 RESPETO • MILAGRO EN MOVIMIENTO</span>
          </div>
        </article>
      </div>
    </section>

    <!-- ==========================================
         ACTO II — SALTO SIN RED (PERÚ ✈️ ARGENTINA)
         ========================================== -->
    <section id="acto-2" class="story-act reverse-layout" data-chapter="acto-2">
      <div class="act-container">
        <div class="act-visual">
          <div class="gta-poster-frame" data-poster>
            <div class="svg-stage" set:html={scene03Svg} />
            <div class="poster-prop-floating prop-bottom-left">
              <VectorProps type="flight-route" />
            </div>
          </div>
        </div>

        <article class="act-card">
          <div class="act-mission-tag">MISIÓN 02 • NUEVO MAPA DESBLOQUEADO</div>
          <p class="act-location">📍 PERÚ ➔ BUENOS AIRES, ARGENTINA</p>
          <h2 class="act-heading">SALTO SIN RED</h2>
          <p class="act-narrative">
            Cuando decidí venir a Argentina, no dudaste ni un segundo en armar las valijas y acompañarme. Porque para vos, donde está tu familia está tu trinchera.
          </p>
          <p class="act-narrative">
            Lejos de quedarte quieta en un país nuevo, saliste a comerte la cancha: empezaste trabajando como <strong>Promotora de Salud</strong> y enseguida te pusiste una meta todavía más grande: estudiar <strong>Enfermería</strong> para transformar tu vocación de cuidar en tu profesión.
          </p>
          <div class="mission-reward-box">
            <span class="reward-label">RECOMPENSA DE MISIÓN</span>
            <span class="reward-value">VOCACIÓN DE SALUD • COMPAÑERA INCONDICIONAL</span>
          </div>
        </article>
      </div>
    </section>

    <!-- ==========================================
         ACTO III — INQUEBRANTABLE (OCTUBRE 2025 / ABANDERADA)
         ========================================== -->
    <section id="acto-3" class="story-act" data-chapter="acto-3">
      <div class="act-container">
        <div class="act-visual">
          <div class="gta-poster-frame" data-poster>
            <div class="svg-stage" set:html={scene04Svg} />
            <div class="poster-prop-floating prop-bottom-right">
              <VectorProps type="watch-s4" />
            </div>
          </div>
        </div>

        <article class="act-card">
          <div class="act-mission-tag">MISIÓN 03 • OCTUBRE 2025</div>
          <p class="act-location">📍 ACTO DE COLACIÓN • ABANDERADA DE HONOR</p>
          <h2 class="act-heading">INQUEBRANTABLE</h2>
          <p class="act-narrative">
            A inicios del 2025 la vida intentó frenarte de golpe con un accidente y múltiples fracturas de cadera. Cualquier otra persona habría abandonado la carrera. Vos no.
          </p>
          <p class="act-narrative">
            En octubre del 2025 fuimos juntos a buscar tu premio como <strong>Abanderada</strong> en silla de ruedas, y el cuatrimestre pasado te graduaste de Enfermera. En tu muñeca brillaba ese <strong>reloj dorado atardecer con su diamante</strong>, porque solo una joya así hace juego con una mujer que brilla hasta en los momentos más duros.
          </p>
          <div class="mission-reward-box">
            <span class="reward-label">EQUIPAMIENTO ÉPICO</span>
            <span class="reward-value">ABANDERADA + XIAOMI WATCH S4 DORADO ATARDECER</span>
          </div>
        </article>
      </div>
    </section>

    <!-- ==========================================
         ACTO IV — LEVEL 58: CREANDO VIDA CON HILOS (AMIGURUMIS)
         ========================================== -->
    <section id="acto-4" class="story-act reverse-layout" data-chapter="acto-4">
      <div class="act-container">
        <div class="act-visual">
          <div class="gta-poster-frame" data-poster>
            <div class="svg-stage" set:html={scene05Svg} />
            <div class="poster-prop-floating prop-top-right">
              <VectorProps type="amigurumi-badge" />
            </div>
          </div>
        </div>

        <article class="act-card">
          <div class="act-mission-tag">MISIÓN 04 • PRESENTE Y PRÓXIMO NIVEL</div>
          <p class="act-location">📍 NIVEL 58 • ENTRE CROCHET Y LA LICENCIATURA</p>
          <h2 class="act-heading">CREANDO VIDA CON HILOS</h2>
          <p class="act-narrative">
            Tu mente inquieta nunca descansa. Mientras esperás los papeles de la matrícula y la convalidación para arrancar el año que viene la <strong>Licenciatura en Enfermería</strong>, encontraste un nuevo arte en tus manos.
          </p>
          <p class="act-narrative">
Entre <strong>ovillos de color y agujas de crochet</strong>, te lanzaste a tejer. Porque hasta cuando descansás, tus manos siguen haciendo lo que mejor saben hacer: dar abrigo, forma y cariño punto por punto.
          </p>
          <div class="mission-reward-box">
            <span class="reward-label">PRÓXIMA EXPANSIÓN</span>
            <span class="reward-value">MAESTRA DEL CROCHET • FUTURA LICENCIADA</span>
          </div>
        </article>
      </div>
    </section>

    <!-- ==========================================
         OUTRO — MISIÓN DE MAÑANA: CELEBRAR + CARTA PERSONAL
         ========================================== -->
    <section id="outro" class="outro-section" data-chapter="outro">
      <div class="outro-Showcase">
        <div class="gta-poster-frame landscape-frame" data-poster>
          <div class="svg-stage" set:html={scene06Svg} />
        </div>

        <div class="act-card">
          <div class="act-mission-tag">MISIÓN FINAL • DÍA DE LA MADRE</div>
          <p class="act-location">📍 CON GERARDO Y FIBIO • MESA RESERVADA</p>
          <h2 class="act-heading">MISIÓN: CELEBRAR JUNTOS</h2>
          <p class="act-narrative">
            Aunque en Perú se celebre en otra fecha, acá celebramos hoy y siempre la suerte inmensa de tenerte. Hoy no
            hay ni trámites, ni exámenes: hoy salimos a comer los tres para brindar por vos.
          </p>
          <div class="mission-reward-box">
            <span class="reward-label">ESTADO DE CAMPAÑA</span>
            <span class="reward-value">100% COMPLETADO • MAMÁ LEYENDA</span>
          </div>
        </div>
      </div>

      <!-- CARTA / DEDICATORIA PERSONAL PARA CORINA: SOBRE INTERACTIVO -->
      <section class="letter-envelope-section" id="carta-mama">
        <div class="envelope-wrapper">
          <div class="envelope-badge-tag">💌 RECOMPENSA FINAL DE CAMPAÑA</div>
          <h3 class="envelope-section-title">UNA CARTA SECRETA PARA VOS</h3>
          <p class="envelope-section-subtitle">
            Misión cumplida, Mamá. Hay un mensaje personal que solo podés abrir vos:
          </p>

          <button id="open-envelope-btn" class="gta-envelope-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="letter-modal" aria-label="Abrir carta para mamá">
            <div class="envelope-mockup" id="envelope-mockup">
              <svg viewBox="0 0 520 340" class="envelope-svg" aria-hidden="true">
                <defs>
                  <linearGradient id="env-grad-body" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#2d1245" />
                    <stop offset="60%" stop-color="#1c0a2d" />
                    <stop offset="100%" stop-color="#12051f" />
                  </linearGradient>
                  <linearGradient id="env-grad-flap" x1="50%" y1="0%" x2="50%" y2="100%">
                    <stop offset="0%" stop-color="#3e195e" />
                    <stop offset="100%" stop-color="#260e3b" />
                  </linearGradient>
                  <linearGradient id="env-grad-gold" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ffd56b" />
                    <stop offset="50%" stop-color="#f6c467" />
                    <stop offset="100%" stop-color="#c98a2c" />
                  </linearGradient>
                  <radialGradient id="env-wax-grad" cx="40%" cy="35%" r="65%">
                    <stop offset="0%" stop-color="#ff7b89" />
                    <stop offset="45%" stop-color="#e63946" />
                    <stop offset="85%" stop-color="#9d0208" />
                    <stop offset="100%" stop-color="#590d22" />
                  </radialGradient>
                  <filter id="env-shadow" x="-10%" y="-10%" width="130%" height="130%">
                    <feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#000" flood-opacity="0.75" />
                  </filter>
                </defs>

                <g filter="url(#env-shadow)">
                  <rect x="20" y="20" width="480" height="300" rx="18" fill="url(#env-grad-body)" stroke="#12071c" stroke-width="5" />
                  <rect x="28" y="28" width="464" height="284" rx="12" fill="none" stroke="url(#env-grad-gold)" stroke-width="2.5" stroke-dasharray="6 4" opacity="0.85" />
                  
                  <path d="M 38 52 L 38 38 L 52 38" fill="none" stroke="url(#env-grad-gold)" stroke-width="3" stroke-linecap="round" />
                  <path d="M 482 52 L 482 38 L 468 38" fill="none" stroke="url(#env-grad-gold)" stroke-width="3" stroke-linecap="round" />
                  <path d="M 38 288 L 38 302 L 52 302" fill="none" stroke="url(#env-grad-gold)" stroke-width="3" stroke-linecap="round" />
                  <path d="M 482 288 L 482 302 L 468 302" fill="none" stroke="url(#env-grad-gold)" stroke-width="3" stroke-linecap="round" />

                  <g class="env-svg-letter">
                    <rect x="52" y="36" width="416" height="150" rx="8" fill="#fffdfa" stroke="#12071c" stroke-width="3" />
                    <line x1="80" y1="65" x2="280" y2="65" stroke="#4a2574" stroke-width="3.5" stroke-linecap="round" opacity="0.4" />
                    <line x1="80" y1="85" x2="380" y2="85" stroke="#4a2574" stroke-width="2.5" stroke-linecap="round" opacity="0.25" />
                    <line x1="80" y1="102" x2="330" y2="102" stroke="#4a2574" stroke-width="2.5" stroke-linecap="round" opacity="0.25" />
                    <text x="80" y="136" font-family="'Playfair Display', serif" font-style="italic" font-weight="600" font-size="20" fill="#2d1245">Querida Mamá: ...</text>
                  </g>

                  <path d="M 20 320 L 260 175 L 500 320 Z" fill="#230c38" stroke="#12071c" stroke-width="4" />
                  <path d="M 20 20 L 260 175 L 20 320 Z" fill="#291040" stroke="#12071c" stroke-width="4" />
                  <path d="M 500 20 L 260 175 L 500 320 Z" fill="#250d3a" stroke="#12071c" stroke-width="4" />

                  <g class="env-svg-flap">
                    <path d="M 20 20 L 500 20 L 260 185 Z" fill="url(#env-grad-flap)" stroke="#12071c" stroke-width="4.5" />
                    <path d="M 40 24 L 480 24 L 260 176 Z" fill="none" stroke="url(#env-grad-gold)" stroke-width="2" opacity="0.8" />
                  </g>

                  <rect x="140" y="240" width="240" height="36" rx="18" fill="url(#env-grad-gold)" stroke="#12071c" stroke-width="3" />
                  <text x="260" y="264" text-anchor="middle" font-family="'Bebas Neue', sans-serif" font-size="19" letter-spacing="2" fill="#12071c">CONFIDENCIAL • PARA MAMÁ</text>

                  <g class="env-svg-seal">
                    <circle class="seal-glow-ring" cx="260" cy="185" r="44" fill="none" stroke="url(#env-grad-gold)" stroke-width="3" opacity="0.8" />
                    <circle cx="260" cy="185" r="36" fill="url(#env-wax-grad)" stroke="#12071c" stroke-width="4" />
                    <circle cx="260" cy="185" r="31" fill="none" stroke="#ffb3ba" stroke-width="1.5" opacity="0.6" />
                    <path d="M 260 174 C 255 165, 241 165, 241 176 C 241 186, 260 199, 260 199 C 260 199, 279 186, 279 176 C 279 165, 265 165, 260 174 Z" fill="url(#env-grad-gold)" stroke="#590d22" stroke-width="1.5" />
                    <text x="260" y="211" text-anchor="middle" font-family="'Outfit', sans-serif" font-weight="800" font-size="9" letter-spacing="1" fill="#ffe6ea">TOCÁ AQUÍ</text>
                  </g>
                </g>
              </svg>
            </div>

            <div class="envelope-cta-label">
              <span class="cta-pulse-dot" aria-hidden="true"></span>
              <span class="cta-text">TOCÁ EL SOBRE PARA ABRIR LA CARTA</span>
              <span class="cta-icon" aria-hidden="true">✨</span>
            </div>
          </button>
        </div>
      </section>
    </section>
  </main>

  <!-- MODAL DE LECTURA INMERSIVA: CARTA DE GERARDO -->
  <div id="letter-modal" class="letter-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="modal-letter-title">
    <div class="letter-modal-backdrop" id="letter-modal-backdrop"></div>
    
    <div class="letter-modal-container">
      <header class="letter-modal-header">
        <div class="letter-seal-badge">💌 CARTA ABIERTA PARA MAMÁ</div>
        <button id="close-letter-btn" class="letter-close-btn" type="button" aria-label="Cerrar carta">
          <span aria-hidden="true">✕</span>
        </button>
      </header>

      <div class="letter-modal-content">
        <h3 id="modal-letter-title" class="letter-greeting">Querida Mamá:</h3>

        <div class="letter-body">
          <p>
            Si alguien me preguntara qué es la fuerza verdadera, no le hablaría de superhéroes de película: le contaría tu historia. Le contaría cómo en Perú, cuando a mi papá le dio el ACV y los médicos decían que no volvería a caminar, vos te plantaste contra todo pronóstico, hiciste oídos sordos a quienes te decían que bajes los brazos y no descansaste hasta verlo caminar de nuevo.
          </p>
          <p>
            Le contaría que cuando me vine a Argentina no lo pensaste dos veces para venirte conmigo y empezar de cero. Que trabajaste como promotora de salud, que te pusiste a estudiar enfermería y que ni siquiera un accidente con múltiples fracturas de cadera pudo impedir que llegaras a ser <strong>Abanderada</strong>. Todavía me emociona acordarme de aquel octubre de 2025, yendo en silla de ruedas a recibir tu premio.
          </p>
          <p>
            Hoy, a tus 58 años, recién graduada, esperando tu matrícula para ir por la Licenciatura el año que viene y llenando la casa de hilos, vinchas y amigurumis tejidos a crochet, me seguís enseñando todos los días que no existe obstáculo más grande que el amor de una madre.
          </p>
          <p>
            Esta página web la hice para que cada vez que la abras —en tu celular, en la compu o en la tele— recuerdes lo gigante que sos para mí y para mi papá. Felíz día mamá. Prepárate que hoy te celebramos como lo que sos: <strong>nuestra protagonista y nuestra Leyenda</strong>.
          </p>
        </div>

        <footer class="letter-signature">
          <div class="signature-block">
            <p class="reward-label">CON TODO MI AMOR Y ORGULLO</p>
            <p class="signature-name">Tu hijo, Gerardo</p>
          </div>
          
          <div class="letter-actions">
            <button id="modal-restart-btn" class="gta-cta-btn" type="button">
              <span>VOLVER AL INICIO</span>
              <span aria-hidden="true">↑</span>
            </button>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { MotionPathPlugin } from 'gsap/MotionPathPlugin';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

    // Initialize Lenis smooth scrolling synced with GSAP ScrollTrigger
    const lenis = new Lenis({
      duration: 1.15,
      smoothWheel: true,
      syncTouch: false,
    });

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // Smooth anchor navigation for chapter dots and CTA buttons
    document.querySelectorAll('a[href^="#"], .chapter-dot').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const targetSel = el.getAttribute('href') || el.getAttribute('data-target');
        if (targetSel) {
          lenis.scrollTo(targetSel, { duration: 1.25 });
        }
      });
    });

    // Responsive & Accessibility-aware GSAP animations via gsap.matchMedia()
    const mm = gsap.matchMedia();

    mm.add(
      {
        isDesktop: '(min-width: 961px)',
        isMobile: '(max-width: 960px)',
        reduceMotion: '(prefers-reduced-motion: reduce)',
      },
      (context) => {
        const { isDesktop, reduceMotion } = context.conditions as {
          isDesktop: boolean;
          isMobile: boolean;
          reduceMotion: boolean;
        };

        if (reduceMotion) {
          gsap.set('.stat-bar-fill, .act-card, [data-poster]', { clearProps: 'all' });
          return;
        }

        // 1. Intro Hero Entrance Timeline
        const introTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        introTl
          .from('.gta-kicker', { y: -25, autoAlpha: 0, duration: 0.6 })
          .from('.gta-main-title', { scale: 0.88, y: 30, autoAlpha: 0, duration: 0.8 }, '-=0.35')
          .from('.gta-subtitle', { y: 20, autoAlpha: 0, duration: 0.6 }, '-=0.45')
          .from('.stat-card', { y: 24, autoAlpha: 0, stagger: 0.1, duration: 0.55 }, '-=0.35')
          .from('.stat-bar-fill', { scaleX: 0, stagger: 0.1, duration: 0.9, ease: 'expo.out' }, '-=0.4')
          .from('#intro [data-poster]', { autoAlpha: 0, duration: 0.8 }, 0.15);

        // 2. Story Acts Entrance & Card Choreography (Posters remain rock-solid and static)
        const acts = gsap.utils.toArray<HTMLElement>('.story-act');
        acts.forEach((act) => {
          const card = act.querySelector('.act-card');
          const poster = act.querySelector('[data-poster]');
          const prop = act.querySelector('.poster-prop-floating');

          const actTl = gsap.timeline({
            scrollTrigger: {
              trigger: act,
              start: 'top 78%',
              end: 'bottom 22%',
              toggleActions: 'play none none reverse',
            },
          });

          if (poster) {
            actTl.from(poster, {
              autoAlpha: 0,
              duration: 0.65,
              ease: 'power2.out',
            });
          }

          if (prop) {
            actTl.from(
              prop,
              {
                scale: 0.6,
                autoAlpha: 0,
                duration: 0.65,
                ease: 'back.out(1.7)',
              },
              '-=0.4'
            );
          }

          if (card) {
            actTl.from(
              card,
              {
                x: isDesktop ? 45 : 0,
                y: isDesktop ? 20 : 35,
                autoAlpha: 0,
                duration: 0.8,
                ease: 'power3.out',
              },
              '-=0.55'
            );
          }
        });

        // 3. Interactive Vector Props Continuous Ambient Animations (Desktop, PC, TV, Mobile)
        // A. Xiaomi Watch S4: diamond sparkle + rotating clock hands
        gsap.to('.diamond-sparkle', {
          rotation: 180,
          scale: 1.3,
          transformOrigin: 'center center',
          duration: 2.2,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
        gsap.to('.watch-hand-min', {
          rotation: 360,
          transformOrigin: '130px 130px',
          duration: 12,
          repeat: -1,
          ease: 'none',
        });
        gsap.to('.watch-hand-hour', {
          rotation: 360,
          transformOrigin: '130px 130px',
          duration: 72,
          repeat: -1,
          ease: 'none',
        });

        // B. ECG Heartbeat Line Pulse
        gsap.fromTo(
          '.ecg-line-path',
          { strokeDasharray: 900, strokeDashoffset: 900 },
          {
            strokeDashoffset: 0,
            duration: 2.6,
            repeat: -1,
            ease: 'power1.inOut',
          }
        );

        // C. Amigurumi Crochet Bear Floating Bounce
        gsap.to('.amigurumi-svg', {
          y: -12,
          rotation: 5,
          transformOrigin: 'top center',
          duration: 2.2,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });

        // D. Perú -> Argentina Flight Route & Airplane Trajectory
        gsap.to('.flight-arc-path', {
          strokeDashoffset: -32,
          duration: 1.2,
          repeat: -1,
          ease: 'none',
        });
        gsap.to('.flight-plane-icon', {
          motionPath: {
            path: '.flight-arc-path',
            align: '.flight-arc-path',
            autoRotate: true,
            alignOrigin: [0.5, 0.5],
          },
          duration: 3.8,
          repeat: -1,
          ease: 'power1.inOut',
        });
        gsap.to('.pin-pulse', {
          r: 24,
          opacity: 0,
          duration: 1.8,
          repeat: -1,
          ease: 'power2.out',
          stagger: 0.9,
        });
        gsap.to('.pin-dot', {
          scale: 1.25,
          transformOrigin: 'center center',
          duration: 1.2,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });

        // E. GTA Legend 5 Stars Shimmer
        gsap.fromTo(
          '.gta-star',
          { scale: 0.92, opacity: 0.8 },
          {
            scale: 1.08,
            opacity: 1,
            transformOrigin: 'center center',
            duration: 1.2,
            repeat: -1,
            yoyo: true,
            stagger: 0.15,
            ease: 'sine.inOut',
          }
        );

        // F. Wax seal ambient pulse on closed envelope
        gsap.to('.seal-glow-ring', {
          scale: 1.45,
          opacity: 0,
          duration: 1.6,
          repeat: -1,
          ease: 'power2.out',
        });

        // 4. Dedication Letter Envelope Reveal
        gsap.from('#carta-mama', {
          y: 40,
          scale: 0.98,
          autoAlpha: 0,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#carta-mama',
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        });

        // 5. Active Chapter Navigation Indicator
        const sections = gsap.utils.toArray<HTMLElement>('section[id]');
        const navDots = gsap.utils.toArray<HTMLElement>('.chapter-dot');

        sections.forEach((section, index) => {
          ScrollTrigger.create({
            trigger: section,
            start: 'top center',
            end: 'bottom center',
            onToggle: (self) => {
              if (self.isActive && navDots[index]) {
                navDots.forEach((d) => d.classList.remove('is-active'));
                navDots[index].classList.add('is-active');
              }
            },
          });
        });
      }
    );

    // ==========================================
    // ENVELOPE OPENING & READING MODAL CONTROLLER
    // ==========================================
    const openEnvelopeBtn = document.getElementById('open-envelope-btn');
    const letterModal = document.getElementById('letter-modal');
    const letterModalBackdrop = document.getElementById('letter-modal-backdrop');
    const closeLetterBtn = document.getElementById('close-letter-btn');
    const modalRestartBtn = document.getElementById('modal-restart-btn');
    const envelopeMockup = document.getElementById('envelope-mockup');

    let isEnvelopeOpening = false;

    function openLetterModal() {
      if (isEnvelopeOpening) return;
      isEnvelopeOpening = true;

      // 1. Trigger flap flip & letter peek animation
      envelopeMockup?.classList.add('is-open');
      openEnvelopeBtn?.setAttribute('aria-expanded', 'true');

      // 2. Short pause for opening gesture, then reveal modal
      window.setTimeout(() => {
        letterModal?.classList.add('is-active');
        letterModal?.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-locked');
        lenis.stop();

        closeLetterBtn?.focus();

        gsap.fromTo(
          '.letter-modal-container',
          { scale: 0.9, y: 30, opacity: 0 },
          { scale: 1, y: 0, opacity: 1, duration: 0.45, ease: 'power3.out' }
        );

        isEnvelopeOpening = false;
      }, 420);
    }

    function closeLetterModal() {
      gsap.to('.letter-modal-container', {
        scale: 0.94,
        y: 20,
        opacity: 0,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          letterModal?.classList.remove('is-active');
          letterModal?.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-locked');
          lenis.start();

          envelopeMockup?.classList.remove('is-open');
          openEnvelopeBtn?.setAttribute('aria-expanded', 'false');
          openEnvelopeBtn?.focus();
        },
      });
    }

    openEnvelopeBtn?.addEventListener('click', openLetterModal);
    closeLetterBtn?.addEventListener('click', closeLetterModal);
    letterModalBackdrop?.addEventListener('click', closeLetterModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && letterModal?.classList.contains('is-active')) {
        closeLetterModal();
      }
    });

    modalRestartBtn?.addEventListener('click', () => {
      closeLetterModal();
      window.setTimeout(() => {
        lenis.scrollTo('#intro', { duration: 1.4 });
      }, 260);
    });
  </script>
</BaseLayout>
